<?xml version="1.0" encoding="utf-8"?>
<!-- MGMemo 图标前景：一张 Markdown 便签（白色纸 + 绿色 M↓ 标记） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 纸张主体（含右上折角） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,26 L63,26 L75,38 L75,78 A5,5 0 0 1 70,83 L37,83 A5,5 0 0 1 32,78 L32,31 A5,5 0 0 1 37,26 Z" />

    <!-- 折角三角（浅绿，表现纸张翻折） -->
    <path
        android:fillColor="#C7E6C9"
        android:pathData="M63,26 L75,38 L63,38 Z" />

    <!-- M 标记 -->
    <path
        android:pathData="M40,62 L40,46 L47,54 L54,46 L54,62"
        android:strokeColor="#2E6B3A"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 向下箭头（Markdown 的 ↓） -->
    <path
        android:pathData="M63,46 L63,59"
        android:strokeColor="#2E6B3A"
        android:strokeWidth="4.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M58.5,54.5 L63,59 L67.5,54.5"
        android:strokeColor="#2E6B3A"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 底部两条文本占位线 -->
    <path
        android:fillColor="#C7E6C9"
        android:pathData="M40,69 L66,69 L66,71.5 L40,71.5 Z" />
    <path
        android:fillColor="#DCEDDD"
        android:pathData="M40,75 L57,75 L57,77.5 L40,77.5 Z" />
</vector>